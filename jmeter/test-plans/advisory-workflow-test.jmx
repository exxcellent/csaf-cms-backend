<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <!-- ================================================================== -->
    <!-- Test Plan: CSAF CMS Backend - Advisory Workflow                     -->
    <!--                                                                      -->
    <!-- Exercises the complete advisory lifecycle using separate author,    -->
    <!-- reviewer, and publisher credentials. This satisfies the default     -->
    <!-- rule that an author may not approve their own advisory.              -->
    <!--                                                                      -->
    <!-- Usage:                                                               -->
    <!--   bash jmeter/run.sh test-plans/advisory-workflow-test.jmx -Jthreads=5 -Jloops=20 -->
    <!-- ================================================================== -->
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="CSAF CMS Backend - Advisory Workflow Test" enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="API_HOST" elementType="Argument"><stringProp name="Argument.name">API_HOST</stringProp><stringProp name="Argument.value">${__P(api.host,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="API_PORT" elementType="Argument"><stringProp name="Argument.name">API_PORT</stringProp><stringProp name="Argument.value">${__P(api.port,8081)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="KEYCLOAK_HOST" elementType="Argument"><stringProp name="Argument.name">KEYCLOAK_HOST</stringProp><stringProp name="Argument.value">${__P(keycloak.host,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="KEYCLOAK_PORT" elementType="Argument"><stringProp name="Argument.name">KEYCLOAK_PORT</stringProp><stringProp name="Argument.value">${__P(keycloak.port,9000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="CLIENT_ID" elementType="Argument"><stringProp name="Argument.name">CLIENT_ID</stringProp><stringProp name="Argument.value">secvisogram</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="CLIENT_SECRET" elementType="Argument"><stringProp name="Argument.name">CLIENT_SECRET</stringProp><stringProp name="Argument.value">${__P(client.secret,dev-only-3f8a1c7e2b9d4f6a0e5c8b3d7a1f9e2c)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="AUTHOR_USERNAME" elementType="Argument"><stringProp name="Argument.name">AUTHOR_USERNAME</stringProp><stringProp name="Argument.value">${__P(author.username,author)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="AUTHOR_PASSWORD" elementType="Argument"><stringProp name="Argument.name">AUTHOR_PASSWORD</stringProp><stringProp name="Argument.value">${__P(author.password,author)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="REVIEWER_USERNAME" elementType="Argument"><stringProp name="Argument.name">REVIEWER_USERNAME</stringProp><stringProp name="Argument.value">${__P(reviewer.username,reviewer)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="REVIEWER_PASSWORD" elementType="Argument"><stringProp name="Argument.name">REVIEWER_PASSWORD</stringProp><stringProp name="Argument.value">${__P(reviewer.password,reviewer)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="PUBLISHER_USERNAME" elementType="Argument"><stringProp name="Argument.name">PUBLISHER_USERNAME</stringProp><stringProp name="Argument.value">${__P(publisher.username,publisher)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="PUBLISHER_PASSWORD" elementType="Argument"><stringProp name="Argument.name">PUBLISHER_PASSWORD</stringProp><stringProp name="Argument.value">${__P(publisher.password,publisher)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <!-- Acquire one JWT for each workflow role and store it as a property. -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="01 - Authenticate workflow users" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController"><stringProp name="LoopController.loops">1</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp>
      </SetupThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Author token" enabled="true">
          <stringProp name="HTTPSampler.domain">${KEYCLOAK_HOST}</stringProp><stringProp name="HTTPSampler.port">${KEYCLOAK_PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/realms/csaf/protocol/openid-connect/token</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments">
            <elementProp name="grant_type" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">grant_type</stringProp><stringProp name="Argument.value">password</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="client_id" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">client_id</stringProp><stringProp name="Argument.value">${CLIENT_ID}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="client_secret" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">client_secret</stringProp><stringProp name="Argument.value">${CLIENT_SECRET}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="username" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">username</stringProp><stringProp name="Argument.value">${AUTHOR_USERNAME}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="password" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">password</stringProp><stringProp name="Argument.value">${AUTHOR_PASSWORD}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
          </collectionProp></elementProp>
        </HTTPSamplerProxy>
        <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract author token" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">AUTHOR_TOKEN</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp></JSONPostProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store author token" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">props.put('AUTHOR_TOKEN', vars.get('AUTHOR_TOKEN'))</stringProp></JSR223PostProcessor><hashTree/></hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Reviewer token" enabled="true">
          <stringProp name="HTTPSampler.domain">${KEYCLOAK_HOST}</stringProp><stringProp name="HTTPSampler.port">${KEYCLOAK_PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/realms/csaf/protocol/openid-connect/token</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments">
            <elementProp name="grant_type" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">grant_type</stringProp><stringProp name="Argument.value">password</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="client_id" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">client_id</stringProp><stringProp name="Argument.value">${CLIENT_ID}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="client_secret" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">client_secret</stringProp><stringProp name="Argument.value">${CLIENT_SECRET}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="username" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">username</stringProp><stringProp name="Argument.value">${REVIEWER_USERNAME}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="password" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">password</stringProp><stringProp name="Argument.value">${REVIEWER_PASSWORD}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
          </collectionProp></elementProp>
        </HTTPSamplerProxy>
        <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract reviewer token" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">REVIEWER_TOKEN</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp></JSONPostProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store reviewer token" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">props.put('REVIEWER_TOKEN', vars.get('REVIEWER_TOKEN'))</stringProp></JSR223PostProcessor><hashTree/></hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Publisher token" enabled="true">
          <stringProp name="HTTPSampler.domain">${KEYCLOAK_HOST}</stringProp><stringProp name="HTTPSampler.port">${KEYCLOAK_PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/realms/csaf/protocol/openid-connect/token</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments">
            <elementProp name="grant_type" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">grant_type</stringProp><stringProp name="Argument.value">password</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="client_id" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">client_id</stringProp><stringProp name="Argument.value">${CLIENT_ID}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="client_secret" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">client_secret</stringProp><stringProp name="Argument.value">${CLIENT_SECRET}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="username" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">username</stringProp><stringProp name="Argument.value">${PUBLISHER_USERNAME}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            <elementProp name="password" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">password</stringProp><stringProp name="Argument.value">${PUBLISHER_PASSWORD}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
          </collectionProp></elementProp>
        </HTTPSamplerProxy>
        <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract publisher token" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">PUBLISHER_TOKEN</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp></JSONPostProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store publisher token" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">props.put('PUBLISHER_TOKEN', vars.get('PUBLISHER_TOKEN'))</stringProp></JSR223PostProcessor><hashTree/></hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="02 - Advisory workflow" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,5)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(rampup,0)}</stringProp><stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController"><stringProp name="LoopController.loops">${__P(loops,20)}</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp>
      </ThreadGroup>
      <hashTree>
        <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="HTTP Cookie Manager" enabled="true"><collectionProp name="CookieManager.cookies"/><boolProp name="CookieManager.clearEachIteration">true</boolProp></CookieManager><hashTree/>
        <!-- The backend uses a cookie CSRF token when CSRF protection is enabled. -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /about (obtain CSRF cookie)" enabled="true"><stringProp name="HTTPSampler.domain">${API_HOST}</stringProp><stringProp name="HTTPSampler.port">${API_PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/v1/about</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy>
        <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract CSRF token" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('XSRF_TOKEN', vars.get('COOKIE_XSRF-TOKEN') ?: '')</stringProp></JSR223PostProcessor><hashTree/></hashTree>

        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Author: create, submit, create version, and submit version" enabled="true"/>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Author headers" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${__P(AUTHOR_TOKEN,)}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-XSRF-TOKEN</stringProp><stringProp name="Header.value">${XSRF_TOKEN}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /advisories (create advisory)" enabled="true"><stringProp name="HTTPSampler.domain">${API_HOST}</stringProp><stringProp name="HTTPSampler.port">${API_PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/v1/advisories</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{
  "summary": "JMeter advisory workflow test",
  "csaf": {
    "document": {
      "category": "generic_csaf", "csaf_version": "2.0",
      "publisher": { "category": "coordinator", "name": "exxcellent", "namespace": "https://exxcellent.de" },
      "title": "JMeter Workflow ${__Random(10000,99999)}",
      "tracking": {
        "current_release_date": "2022-01-11T11:00:00.000Z", "initial_release_date": "2022-01-12T11:00:00.000Z",
        "id": "JMeter-Workflow-${__UUID}", "status": "draft", "version": "0.0.1",
        "revision_history": [{ "date": "2022-01-12T11:00:00.000Z", "number": "0.0.1", "summary": "JMeter advisory workflow test" }],
        "generator": { "date": "2022-01-11T04:07:27.246Z", "engine": { "version": "1.10.0", "name": "JMeter" } }
      },
      "acknowledgments": [{ "names": ["JMeter"], "organization": "exxcellent", "summary": "Workflow test", "urls": ["https://exxcellent.de"] }]
    }
  }
}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy>
          <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 201" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="">201</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract advisory ID and initial revision" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">advisoryId;initialRevision</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.id;$.revision</stringProp><stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;NOT_FOUND</stringProp></JSONPostProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Initialize revision" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('revision', vars.get('initialRevision'))</stringProp></JSR223PostProcessor><hashTree/></hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="PATCH Draft to Review" enabled="true"><stringProp name="HTTPSampler.domain">${API_HOST}</stringProp><stringProp name="HTTPSampler.port">${API_PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/v1/advisories/${advisoryId}/workflowstate/Review?revision=${revision}</stringProp><stringProp name="HTTPSampler.method">PATCH</stringProp></HTTPSamplerProxy>
          <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store new revision" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def body = prev.getResponseDataAsString().trim(); if (body) { vars.put('revision', body) } else { vars.put('revision', (vars.get('revision').toInteger() + 1).toString()) }</stringProp></JSR223PostProcessor><hashTree/></hashTree>
        </hashTree>

        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Reviewer: approve initial advisory" enabled="true"/>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Reviewer headers" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${__P(REVIEWER_TOKEN,)}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-XSRF-TOKEN</stringProp><stringProp name="Header.value">${XSRF_TOKEN}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="PATCH Review to Approved" enabled="true"><stringProp name="HTTPSampler.domain">${API_HOST}</stringProp><stringProp name="HTTPSampler.port">${API_PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/v1/advisories/${advisoryId}/workflowstate/Approved?revision=${revision}</stringProp><stringProp name="HTTPSampler.method">PATCH</stringProp></HTTPSamplerProxy>
          <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store new revision" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def body = prev.getResponseDataAsString().trim(); if (body) { vars.put('revision', body) } else { vars.put('revision', (vars.get('revision').toInteger() + 1).toString()) }</stringProp></JSR223PostProcessor><hashTree/></hashTree>
        </hashTree>

        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Publisher: Approved to Draft, then publish" enabled="true"/>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Publisher headers" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${__P(PUBLISHER_TOKEN,)}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-XSRF-TOKEN</stringProp><stringProp name="Header.value">${XSRF_TOKEN}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="PATCH Approved to Draft" enabled="true"><stringProp name="HTTPSampler.domain">${API_HOST}</stringProp><stringProp name="HTTPSampler.port">${API_PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/v1/advisories/${advisoryId}/workflowstate/Draft?revision=${revision}</stringProp><stringProp name="HTTPSampler.method">PATCH</stringProp></HTTPSamplerProxy>
          <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store new revision" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def body = prev.getResponseDataAsString().trim(); if (body) { vars.put('revision', body) } else { vars.put('revision', (vars.get('revision').toInteger() + 1).toString()) }</stringProp></JSR223PostProcessor><hashTree/></hashTree>
        </hashTree>

        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Author: re-submit, request publication, and create new version" enabled="true"/>
        <hashTree>
